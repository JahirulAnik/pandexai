{
  "name": "pandexai",
  "version": "0.1.14",
  "description": "PandexAI - AI-native data profiling CLI. Run pandex init inside your project to get started.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jahirulanik/pandexai.git"
  },
  "keywords": [
    "pandas",
    "data",
    "cli",
    "ai"
  ],
  "bin": {
    "pandex": "./bin/pandex.js"
  },
  "files": [
    "bin",
    "SKILL.md",
    "commands",
    "scripts",
    "!scripts/__pycache__",
    ".claude"
  ],
  "scripts": {
    "test": "node --test tests/node/*.test.js",
    "test:py": "pytest -q",
    "lint": "ruff check scripts tests"
  },
  "engines": {
    "node": ">=18"
  }
}
